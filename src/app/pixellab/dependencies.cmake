# Download exact, hash-verified public dependencies at configure time.
set(PIXELLAB_DEPS_DIR "${CMAKE_CURRENT_BINARY_DIR}/deps")
function(pixellab_dependency name url digest)
  set(out "${PIXELLAB_DEPS_DIR}/vendor/${name}")
  get_filename_component(dir "${out}" DIRECTORY)
  file(MAKE_DIRECTORY "${dir}")
  if(EXISTS "${out}")
    file(SHA256 "${out}" existing_hash)
    if(NOT existing_hash STREQUAL digest)
      file(REMOVE "${out}")
    endif()
  endif()
  if(NOT EXISTS "${out}")
    file(DOWNLOAD "${url}" "${out}" TLS_VERIFY ON
      EXPECTED_HASH "SHA256=${digest}" STATUS download_status)
    list(GET download_status 0 code)
    if(NOT code EQUAL 0)
      message(FATAL_ERROR "PixelLab dependency download failed: ${name}: ${download_status}")
    endif()
  endif()
endfunction()
